# 复制为 .env 后按环境修改（.env 不要提交到 Git）
# cp .env.example .env

# ---------- Docker Compose ----------
MYSQL_IMAGE=zziaguan/mysql:8.0.46
MYSQL_CONTAINER_NAME=mysql8046
MYSQL_PORT=3306

# ---------- MinIO（本地 S3 兼容存储）----------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change_me_minio_password

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=testdb
MYSQL_USER=testuser
MYSQL_PASSWORD=change_me_user_password

# 备份专用账号（可选，留空则使用 MYSQL_USER / MYSQL_ROOT_PASSWORD）
# MYSQL_BACKUP_USER=
# MYSQL_BACKUP_PASSWORD=

# ---------- S3 对象存储 ----------
S3_BACKUP_ENABLED=true
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=change_me_minio_password
S3_BUCKET=mysql
S3_REGION=us-east-1
S3_USE_SSL=false
S3_FORCE_PATH_STYLE=true
S3_ALIAS=s3

# ---------- 备份调度与保留 ----------
BACKUP_BASE_DIR=/backups
# 生产建议: 全量 0 2 * * *，增量 */10 * * * * 或 0 * * * *
FULL_BACKUP_SCHEDULE=*/3 * * * *
INCREMENTAL_BACKUP_SCHEDULE=* * * * *
BACKUP_RETENTION_DAYS=14
# 上传到 S3 并校验通过后，本地保留小时数（0=立即删除）
LOCAL_BACKUP_RETENTION_HOURS=0
CLEANUP_LOCAL_SCHEDULE=* * * * *

# ---------- 钉钉通知（可选）----------
DINGTALK_WEBHOOK_ENABLED=false
DINGTALK_WEBHOOK_URL=

# ---------- 时区 ----------
TZ=Asia/Shanghai
RESTORE_TZ=Asia/Shanghai
BACKUP_TIMEZONE=Asia/Shanghai

# ---------- 控制台 ----------
CONSOLE_IMAGE=mysql-console:latest
CONSOLE_PORT=8888
CONSOLE_ADMIN_USER=admin
CONSOLE_ADMIN_PASSWORD=change_me_console_password
CONSOLE_SECRET_KEY=change_me_console_secret
# 控制台容器内访问 MySQL 使用服务名和容器端口，不要用宿主机映射端口
CONSOLE_MYSQL_HOST=mysql
CONSOLE_MYSQL_PORT=3306
STORAGES_CONFIG_FILE=/shared/storages.json
BACKUP_POLICY_FILE=/shared/backup_policy.json
FULL_BACKUP_RETENTION_DAYS=30
INCREMENTAL_BACKUP_RETENTION_DAYS=14
CLEANUP_S3_SCHEDULE=0 4 * * *

# ---------- 监控采样 ----------
# 排障可调到 3；点数默认按 3 秒间隔保留约 24 小时
HOST_METRICS_COLLECT_INTERVAL=3
HOST_METRICS_MAX_POINTS=28800
HOST_METRICS_RETENTION_SECONDS=86400
